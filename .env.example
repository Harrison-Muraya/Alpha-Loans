# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me
DEBUG=False

DB_NAME=loans
DB_USER=loans
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Comma-separated. Defaults already include the current HTTP deployment.
ALLOWED_HOSTS=197.248.201.233,192.168.100.26,localhost,127.0.0.1

# Leave false for the plain-HTTP service at http://197.248.201.233:9000.
# Set true only after TLS is in front of the app. That enables secure cookies,
# HSTS, and the SSL redirect.
USE_HTTPS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Addresses allowed to set X-Forwarded-For (your nginx). Direct clients are ignored.
TRUSTED_PROXY_IPS=127.0.0.1,::1

CSRF_TRUSTED_ORIGINS=http://197.248.201.233:9000,https://197.248.201.233:9000,http://192.168.100.26:8000,http://127.0.0.1:8000,http://localhost:8000

LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=50
LOGIN_LOCKOUT_SECONDS=900

ACTIVITY_LOG_DEDUPE_SECONDS=900
ACTIVITY_LOG_RETENTION_DAYS=30

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
